{% if kinds is defined %}
    <form name="type" method="post">
        <table id="type">
            <tr>
                <td><label for="type_name">Name</label></td>
                <td><input type="text" id="type_name" name="type_name" {% if record is defined %}value="{{ record.name }}"{% endif%} maxlength="50" autocomplete="on" required autofocus/></td>
            </tr>
            <tr>
                <td><label for="type_kind_id">Kind</label></td>
                <td>
                    <select id="type_kind_id" name="type_kind_id" required>
                        <option value=""{% if record is not defined %} selected{% endif %}>=== Select Kind ===</option>
                        {% for kind in kinds %}
                            <option value="{{ kind.id }}"{% if record is defined and kind.id == record.kind_id %} selected{% endif %}>{{ kind.name }}</option>
                        {% endfor %}
                    </select>
                </td>
            </tr>
        </table>
        <input type="submit" value="Submit"/>
    </form>
{% endif %}
