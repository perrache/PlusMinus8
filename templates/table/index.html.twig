{% extends 'base.html.twig' %}

{% block body %}
    <div class="content1">
        <h1>{{ title }}</h1>
        {% if records1.(0) is defined %}
            <h3>{{ records1|length }} records</h3>
            {% if sql3 == 'mies' %}
                {% set iter = '' %}
                {% for record1 in records1 %}
                    {% if record1.smies != iter %}
                        <div class="new"><a href="dupa">{{ record1.smies }}</a></div>
                        {% set iter = record1.smies %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            <table>
                <tr>
                    {% for col in records1.(0)|keys %}
                        {% if col|first != 'x' %}
                            <th>{{ col|slice(1)|capitalize }}</th>
                        {% endif %}
                    {% endfor %}
                    {% if tab >= 0 %}
                        <th>&nbsp;</th>
                    {% endif %}
                </tr>
                {% for record1 in records1 %}
                    <tr>
                        {% for col in record1|keys %}
                            {% if col|first != 'x' %}
                                {% if col|first == 'n' %}
                                    {% set tdStyle = ' style="text-align: right"' %}
                                {% elseif col|first == 'c' %}
                                    {% set tdStyle = ' style="text-align: center"' %}
                                {% else %}
                                    {% set tdStyle = '' %}
                                {% endif %}
                                <td{{ tdStyle|raw }}>{{ record1.(col) }}</td>
                            {% endif %}
                        {% endfor %}
                        {% if tab >= 0 %}
                            <td>
                                <a href="{{ path('route_sql', {'tab': tab, 'id': record1.nid, 'subtab': 1}) }}"{% if id == record1.nid %} style="color: yellow"{% endif %}>==></a>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </table>
        {% else %}
            <h3>no records found</h3>
        {% endif %}
    </div>
    {% if records5.(0) is defined %}
        <div class="content2">
            <h1>Details</h1>
            <h3>{{ records5|length }} records</h3>
            {% for key, eskuel5 in sql5 %}
                <div class="new">
                    <a href="{{ path('route_sql', {'tab': tab, 'id': id, 'subtab': key}) }}"{% if subtab == key %} style="color: yellow"{% endif %}>{{ eskuel5.name }}</a>
                </div>
            {% endfor %}
            <table>
                <tr>
                    {% for col in records5.(0)|keys %}
                        {% if col|first != 'x' %}
                            <th>{{ col|slice(1)|capitalize }}</th>
                        {% endif %}
                    {% endfor %}
                </tr>
                {% for record5 in records5 %}
                    <tr>
                        {% for col in record5|keys %}
                            {% if col|first != 'x' %}
                                <td{% if col|first == 'n' %} style="text-align: right"{% elseif col|first == 'c' %} style="text-align: center"{% endif %}>{{ record5.(col) }}</td>
                            {% endif %}
                        {% endfor %}
                    </tr>
                {% endfor %}
            </table>
        </div>
    {% endif %}
{% endblock %}
